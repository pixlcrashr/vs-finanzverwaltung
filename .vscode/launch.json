{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VSFV: serve (debug)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["serve", "--config", "${workspaceFolder}/config.dev.yaml"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web: Serve Mock (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web:serve:mock",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    },
    {
      "name": "Web: Serve API (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web:serve:api",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    },
    {
      "name": "Web: Test (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web:test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "Web: Serve Mock + Debug",
      "configurations": ["Web: Serve Mock (Chrome)"]
    },
    {
      "name": "Web: Serve API + Debug",
      "configurations": ["Web: Serve API (Chrome)"]
    }
  ]
}
